<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <delete id="website.menu_contactus" model="website.menu"/>

    <record id="website.default_website" model="website">
        <field name="name">lightsystem</field>
        <field name="logo" type="base64" file="lightsystem_website/static/src/img/lightsystem_logo.svg"/>
        <field name="social_github">https://github.com/LightSystem</field>
        <field name="social_linkedin">https://www.linkedin.com/in/lightsystem</field>
    </record>

    <!-- Home Page Template -->
    <template id="homepage" inherit_id="website.homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure">
                <section class="s_hero text-white"
                         style="background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('/lightsystem_website/static/src/img/top_banner.png'); background-size: cover; background-position: center;">
                    <div class="container">
                        <h1 class="text-white">Welcome</h1>
                    </div>
                </section>
            </div>
        </xpath>
    </template>

    <!-- Services Page Template -->
    <template id="services" name="Services">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="s_hero text-white"
                         style="background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('/lightsystem_website/static/src/img/top_banner.png'); background-size: cover; background-position: center;">
                    <div class="container">
                        <h1 class="text-white">Let’s unblock your business</h1>
                        <div class="lead mx-auto text-white">
                            <p>Technology should adapt to your business.</p>
                            <p>
                                Let us find the solutions that integrate into your daily reality, streamlining
                                operations so you can focus on growth.
                            </p>
                        </div>
                    </div>
                </section>

                <section class="s_text_block">
                    <div class="container">
                        <div class="row g-5 text-center">
                            <div class="col-lg-4">
                                <div class="o_develop_label mb-3">ERP</div>
                                <h3>Tailored implementation</h3>
                                <p class="text-muted">
                                    Odoo is a powerful ERP system designed to be cost-effective and maximally adaptable.
                                    We ensure your implementation is tailored to your unique business needs.
                                </p>
                            </div>
                            <div class="col-lg-4">
                                <div class="o_preview_label mb-3">Integrations</div>
                                <h3>Automated operations</h3>
                                <p class="text-muted">
                                    We connect your existing tools so your data flows seamlessly, removing
                                    inefficiencies and manual work.
                                </p>
                            </div>
                            <div class="col-lg-4">
                                <div class="o_ship_label mb-3">Strategy</div>
                                <h3>Architectural vision</h3>
                                <p class="text-muted">
                                    Turning ideas into value through big-picture thinking. Leveraging custom software to
                                    provide the agility for small/medium companies to lead and innovate in an era of
                                    constant disruption and opportunity.
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="s_features bg-light">
                    <div class="container">
                        <div class="row g-4">
                            <div class="col-lg-4">
                                <div class="card h-100 p-5">
                                    <div class="o_metric mb-3">10x</div>
                                    <h4 class="mb-3">Faster Cycles</h4>
                                    <p class="text-muted mb-0">
                                        Reduce your time to market with our automated
                                        deployment pipelines and optimized workflows.
                                    </p>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="card h-100 p-5">
                                    <div class="o_metric mb-3">99.9%</div>
                                    <h4 class="mb-3">Uptime</h4>
                                    <p class="text-muted mb-0">
                                        Enterprise-grade reliability that grows with you.
                                        Your business never sleeps, and neither do we.
                                    </p>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="card h-100 p-5">
                                    <div class="o_metric mb-3">0</div>
                                    <h4 class="mb-3">Config</h4>
                                    <p class="text-muted mb-0">
                                        Zero-configuration deployments. Just push your code
                                        and we'll handle the rest, from SSL to CDN.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="s_text_block py-5">
                    <div class="container text-center py-5">
                        <h2 class="mb-4">Ready to talk?</h2>
                        <a href="/contactus" class="btn btn-primary btn-lg px-5 rounded-pill">Contact Me</a>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!-- About Me Template -->
    <template id="about_me" name="About Me">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <img src="/lightsystem_website/static/src/img/profile.jpg" alt="Profile" width="372" class="img-fluid d-block mx-auto"/>
            </div>
        </t>
    </template>

    <!-- Services Page -->
    <record id="services_page" model="website.page">
        <field name="name">Services</field>
        <field name="url">/services</field>
        <field name="view_id" ref="services"/>
        <field name="is_published">True</field>
        <field name="track">True</field>
        <field name="website_id" ref="website.default_website"/>
    </record>

    <!-- About Me Page -->
    <record id="about_me_page" model="website.page">
        <field name="name">About Me</field>
        <field name="url">/about-me</field>
        <field name="view_id" ref="about_me"/>
        <field name="is_published">True</field>
        <field name="track">True</field>
        <field name="website_id" ref="website.default_website"/>
    </record>

    <!-- Services Menu -->
    <record id="menu_services" model="website.menu">
        <field name="name">Services</field>
        <field name="url">/services</field>
        <field name="page_id" ref="services_page"/>
        <field name="parent_id" search="[
                ('url', '=', '#'),
                ('website_id', '=', 1)]"/>
        <field name="website_id" ref="website.default_website"/>
        <field name="sequence" type="int">20</field>
    </record>

    <!-- About Me Menu -->
    <record id="menu_about_me" model="website.menu">
        <field name="name">About Me</field>
        <field name="url">/about-me</field>
        <field name="page_id" ref="about_me_page"/>
        <field name="parent_id" search="[
                ('url', '=', '#'),
                ('website_id', '=', 1)]"/>
        <field name="website_id" ref="website.default_website"/>
        <field name="sequence" type="int">21</field>
    </record>
</odoo>
